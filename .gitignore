# The compiled site. Built by scripts/build_site.py and published by CI, so it
# is never committed — that way the Markdown cannot drift from the HTML.
_site/

# Scratch renders from previewing the site locally.
site-*.png
.playwright-mcp/

# Claude Code session state, including worktrees.
.claude/

# Supabase CLI scratch. This repo has no Supabase project — the directory only
# appears if a `supabase` command is run from here by mistake, and .temp/
# records which project the CLI was last linked to.
supabase/

.DS_Store
__pycache__/
